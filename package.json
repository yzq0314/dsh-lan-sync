{
  "name": "dsh-lan-sync",
  "version": "0.2.0",
  "private": true,
  "description": "Pair DSH hosts on a private LAN and preview or apply selected Desktop plugins and portable preferences locally.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "lib/profile_sync.py",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "lib/sync_menu.py"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-plugin-manager": "*",
    "@deepseek-ai/dsh-config-editor": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "profile-sync": "python lib/profile_sync.py",
    "sync-menu": "python lib/sync_menu.py ."
  },
  "license": "MIT"
}
